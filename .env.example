# MySQL bağlantısı
# Yerel (Homebrew, şifresiz root): mysql://root@localhost:3306/akademi_koc
# Şifreli: mysql://KULLANICI:SIFRE@localhost:3306/akademi_koc
DATABASE_URL="mysql://root@localhost:3306/akademi_koc"

AUTH_SECRET="degistir-bunu-uzun-rastgele-bir-anahtar"
GOOGLE_CLIENT_ID=""
